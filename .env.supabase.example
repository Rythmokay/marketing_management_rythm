# Copy to .env.supabase (git-ignored) and run with the "supabase" profile:
#   SPRING_PROFILES_ACTIVE=supabase ./gradlew bootRun
# Values: Supabase dashboard → project → Connect → Session pooler.
SUPABASE_DB_HOST=aws-0-<region>.pooler.supabase.com
SUPABASE_DB_PORT=5432
SUPABASE_DB_NAME=postgres
SUPABASE_DB_USERNAME=postgres.<project ref>
SUPABASE_DB_PASSWORD=
