# Copy to .env (never commit .env). The same variables go into Dokploy's Environment tab.

# PostgreSQL (on Dokploy: values from the database's "Internal Credentials")
DB_HOST=<Internal Host of the rythm_marketing_management PostgreSQL in Dokploy>
DB_PORT=5432
DB_NAME=
DB_USERNAME=
DB_PASSWORD=

# Signs login tokens. Generate once: openssl rand -base64 48
JWT_SECRET=

# Password for the "admin" account, used only on the very first start (empty database).
# Change it later on the Marketing Team page.
APP_ADMIN_PASSWORD=

# Optional: Gemini API key (https://aistudio.google.com/apikey) for "Find review with Gemini".
# GEMINI_MODEL defaults to gemini-flash-latest.
GEMINI_API_KEY=
GEMINI_MODEL=

# Local docker compose only: port on your computer (default 8081)
APP_PORT=8081
